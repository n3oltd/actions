########################
### base
########################
# The digest is what the build's signature check verifies; a tag can move after it.
FROM litellm/litellm:v1.105.1@sha256:b7b9e2c306343721802253d0dd9436b9634a2eb4e14da7c7cf06c5c7b7530802 AS base

########################
### final
########################
FROM base AS final

LABEL org.opencontainers.image.title="LiteLLM"
LABEL org.opencontainers.image.description="LiteLLM's signed proxy image, reading nothing from GitHub at runtime."

# Unset, each reads a file from LiteLLM's main branch at runtime; the build checks all are set.
ENV LITELLM_LOCAL_MODEL_COST_MAP="True" \
    LITELLM_LOCAL_ANTHROPIC_BETA_HEADERS="True" \
    LITELLM_LOCAL_AUTOROUTER_PRESETS="True" \
    LITELLM_LOCAL_BLOG_POSTS="True" \
    LITELLM_LOCAL_POLICY_TEMPLATES="True"
