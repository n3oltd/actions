########################
### base
########################
# open_clip_torch and timm publish no 3.13 classifier.
FROM python:3.14-slim AS base

########################
### final
########################
FROM base AS final

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/huggingface

WORKDIR /opt/clip

COPY resourcespace-clip-requirements.txt /opt/clip/requirements.txt

# The default PyPI torch bundles CUDA; this service is CPU-only.
RUN pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cpu \
      --extra-index-url https://pypi.org/simple \
      -r /opt/clip/requirements.txt

COPY resourcespace-clip-service.py /opt/clip/clip_service.py

# Unbaked, open_clip fetches 1.5 GB on every container start.
COPY resourcespace-clip-bake.py /tmp/bake.py
RUN python /tmp/bake.py && rm -f /tmp/bake.py

# A start that would have downloaded fails, rather than pulling weights over the
# network on every replica start.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# The build proves the bake was complete; otherwise the first evidence of a
# missing file is a container that will not start, wherever it was deployed.
RUN python -c "import re, open_clip; src = open('/opt/clip/clip_service.py').read(); name = re.search(r'^MODEL_NAME = \"(.+)\"$', src, re.M).group(1); tag = re.search(r'^MODEL_PRETRAINED = \"(.+)\"$', src, re.M).group(1); open_clip.create_model_and_transforms(name, pretrained=tag); open_clip.get_tokenizer(name); print('offline load ok')"

RUN useradd --system --uid 10001 --create-home clip \
 && chown -R clip:clip /opt/clip /opt/huggingface

USER clip

EXPOSE 8000

CMD ["python", "/opt/clip/clip_service.py"]
