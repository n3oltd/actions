########################
### base
########################
FROM mcr.microsoft.com/dotnet/aspnet:10.0.15-noble AS base

RUN sed -i \
        -e 's#http://archive.ubuntu.com/ubuntu/#http://azure.archive.ubuntu.com/ubuntu/#' \
        -e 's#http://security.ubuntu.com/ubuntu/#http://azure.archive.ubuntu.com/ubuntu/#' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && grep -q 'azure.archive.ubuntu.com' /etc/apt/sources.list.d/ubuntu.sources \
    && ! grep -Eq '//(archive|security)\.ubuntu\.com/' /etc/apt/sources.list.d/ubuntu.sources

WORKDIR /app

########################
### build
########################
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build

ARG PROJECT
ARG PROJECT_PATH
ARG VERSION
ARG SOURCE_REVISION_ID

WORKDIR /src

ENV PROJECT=${PROJECT}

COPY . .

# Monorepo callers build with the repo root as the context and pass PROJECT_PATH (the project
# directory, context-relative); single-repo callers build with the project's parent as the context
# and pass PROJECT only, so PROJECT_PATH defaults to PROJECT.
RUN cd "/src/${PROJECT_PATH:-$PROJECT}" \
 && dotnet build --configuration Release --output /build /p:Version=${VERSION:-1.0.0} /p:SourceRevisionId=${SOURCE_REVISION_ID}

########################
### publish
########################
FROM build AS publish

ARG PROJECT
ARG PROJECT_PATH
ARG VERSION
ARG SOURCE_REVISION_ID

RUN cd "/src/${PROJECT_PATH:-$PROJECT}" \
 && dotnet publish "${PROJECT}.csproj" --configuration Release --output /publish /p:Version=${VERSION:-1.0.0} /p:SourceRevisionId=${SOURCE_REVISION_ID}

########################
### final
########################
FROM base AS final

RUN apt-get update
RUN echo "yes" | apt install ttf-mscorefonts-installer --assume-yes
RUN apt-get install --assume-yes curl wget zip unzip ghostscript git make gdebi fontconfig

ARG PROJECT

WORKDIR /publish

ENV ASPNETCORE_URLS http://*:80
ENV DLL="${PROJECT}.dll"

COPY --from=publish /publish .

RUN echo "#!/bin/sh\nexec dotnet ${DLL}" > ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]

EXPOSE 80
