########################
### base
########################
FROM node:24.20.0-slim AS base

WORKDIR /app

########################
### build
########################
FROM base AS builder

# The slim base purges its own ca-certificates once Node is unpacked.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG REACT_APP_SENTRY_RELEASE

# webpack 4 hashes with MD4, which OpenSSL 3 only exposes via the legacy provider.
ENV REACT_APP_SENTRY_RELEASE=${REACT_APP_SENTRY_RELEASE} \
    NODE_OPTIONS="--max-old-space-size=8192 --openssl-legacy-provider" \
    GENERATE_SOURCEMAP=true

COPY package.json package-lock.json .npmrc ./

RUN --mount=type=secret,id=github_token,required=true \
    GH_PAT="$(cat /run/secrets/github_token)" \
    npm ci

COPY . .

ENV NODE_ENV=production

RUN --mount=type=secret,id=github_token,required=true \
    GH_PAT="$(cat /run/secrets/github_token)" \
    npm run build

########################
### sourcemaps
########################
FROM scratch AS sourcemaps

COPY --from=builder /app/build/static/js/ /

########################
### served
########################
FROM builder AS served

# Deleting after the final stage's copy only writes whiteouts; the bytes stay beneath.
RUN find /app/build -name '*.map' -delete

########################
### final
########################
FROM node:24.20.0-slim AS final

WORKDIR /app

ARG BUILD_VERSION
ARG COMMIT_SHA
ENV BUILD_VERSION=${BUILD_VERSION} COMMIT_SHA=${COMMIT_SHA}

RUN npm install express@5.2.1

COPY --from=served /app/build ./build

COPY server.js ./

EXPOSE 3000

CMD ["node", "server.js"]
