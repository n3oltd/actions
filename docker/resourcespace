########################
### base
########################
# The pinned ResourceSpace release targets the PHP this base ships. Held at 24.x.
FROM ubuntu:24.04 AS base

########################
### final
########################
FROM base AS final

LABEL org.opencontainers.image.title="ResourceSpace"
LABEL org.opencontainers.image.description="ResourceSpace digital asset management, configured at container start from the environment."

ENV DEBIAN_FRONTEND="noninteractive"

RUN apt-get update && apt-get install -y --no-install-recommends \
    antiword \
    apache2 \
    # Nothing else here pulls a trust store in without recommended packages.
    ca-certificates \
    ffmpeg \
    ghostscript \
    imagemagick \
    inkscape \
    libapache2-mod-php \
    libimage-exiftool-perl \
    libopencv-dev \
    # What unoconv drives to preview office formats.
    libreoffice-calc \
    libreoffice-impress \
    libreoffice-writer \
    mariadb-client \
    php \
    php-apcu \
    php-curl \
    php-gd \
    php-imap \
    php-intl \
    php-json \
    php-ldap \
    php-mbstring \
    php-mysqlnd \
    php-xml \
    php-zip \
    poppler-utils \
    python3 \
    python3-opencv \
    subversion \
    unoconv \
    zip \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Derived, so a newer base fails on something meaningful rather than on a path.
RUN PHP_SERIES="$(php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')" \
 && INI="/etc/php/${PHP_SERIES}/apache2/php.ini" \
 && test -f "$INI" \
 # Upstream's 100M is a limit for photographs; this ingests video.
 && sed -i -e "s/^upload_max_filesize\s*=.*/upload_max_filesize = 4G/" "$INI" \
 && sed -i -e "s/^post_max_size\s*=.*/post_max_size = 4G/" "$INI" \
 && sed -i -e "s/^max_execution_time\s*=.*/max_execution_time = 300/" "$INI" \
 && sed -i -e "s/^memory_limit\s*=.*/memory_limit = 1G/" "$INI" \
 && grep -q '^upload_max_filesize = 4G' "$INI"

# prefork gives every worker a whole interpreter entitled to memory_limit, so
# upstream's 150 against a 1G limit describes no bound a container can honour.
# Requests queue past 24 rather than the container being killed.
RUN sed -i -e "s/^\(\s*\)MaxRequestWorkers.*/\1MaxRequestWorkers       24/" \
           -e "s/^\(\s*\)MaxSpareServers.*/\1MaxSpareServers         8/" \
           -e "s/^\(\s*\)StartServers.*/\1StartServers            4/" \
           /etc/apache2/mods-available/mpm_prefork.conf \
 && grep -q 'MaxRequestWorkers       24' /etc/apache2/mods-available/mpm_prefork.conf

RUN printf '<Directory /var/www/>\n\tOptions FollowSymLinks\n</Directory>\n' \
      >> /etc/apache2/sites-enabled/000-default.conf

RUN sed -i -e "s|^ErrorLog .*|ErrorLog /dev/stderr|" /etc/apache2/apache2.conf \
 && grep -q '^ErrorLog /dev/stderr' /etc/apache2/apache2.conf

WORKDIR /var/www/html

# Released over Subversion rather than as tags or images. Bumping this is what a
# new ResourceSpace looks like.
ARG RESOURCESPACE_RELEASE=https://svn.resourcespace.com/svn/rs/releases/11.0

RUN rm -f index.html \
 && svn co -q "$RESOURCESPACE_RELEASE" . \
 && mkdir -p /var/www/filestore /var/www/scratch \
 && chown -R www-data:www-data /var/www/filestore /var/www/scratch \
 && chmod -R 777 include/

# Each patch is asserted, so a release that has moved one of these lines fails
# here rather than shipping a plugin that writes vectors the service cannot read.
COPY --chmod=0755 resourcespace-fork.sh /tmp/resourcespace-fork.sh
RUN /tmp/resourcespace-fork.sh /var/www/html && rm -f /tmp/resourcespace-fork.sh

COPY --chmod=0644 resourcespace-branding.yaml /var/www/html/plugins/n3o_branding/n3o_branding.yaml
RUN mkdir -p /var/www/html/plugins/n3o_branding/css /var/www/html/gfx/brand \
 && chown -R www-data:www-data /var/www/html/plugins/n3o_branding /var/www/html/gfx/brand

COPY --chmod=0644 resourcespace-render-config.php /usr/local/bin/resourcespace-render-config.php
COPY --chmod=0755 resourcespace-entrypoint.sh /usr/local/bin/resourcespace-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/resourcespace-entrypoint.sh"]
