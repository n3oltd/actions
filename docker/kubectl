########################
### base
########################
FROM debian:trixie-20260824-slim AS base

########################
### final
########################
FROM base AS final

# The upstream image is distroless; the jobs using this one are shell scripts that report over HTTP.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
 && curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.36/deb/Release.key \
      | gpg --dearmor -o /etc/apt/keyrings/kubernetes.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/kubernetes.gpg] https://pkgs.k8s.io/core:/stable:/v1.36/deb/ /" \
      > /etc/apt/sources.list.d/kubernetes.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends kubectl \
 && apt-get purge -y gnupg \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --uid 65532 --create-home --shell /bin/bash nonroot

USER nonroot
WORKDIR /home/nonroot

CMD ["/bin/bash"]
