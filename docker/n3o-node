# n3o-node — a Node-built web deployable.
#
# Build-args:
#   VARIANT          static (Caddy), node (a server), next (Next standalone) or oauth (oauth2-proxy over static)
#   PACKAGE          workspace package, or the directory to build in outside a workspace
#   BUILD_SCRIPT     package script to run (default: build)
#   OUTPUT_DIR       context-relative built output — static and oauth; the .next directory for next
#   APP_DIR          next only: the app's path within the context, `.` at the context root
#   START_ENTRY      entry the server runs — node
#   PORT             port the final image listens on (default 8080)
#   BASE_PATH        public path the static site is served under
#   ENV_PREFIX       env vars with this prefix reach the browser as window.__APP_ENV__
#   NEXT_PUBLIC_TYPESENSE_URL, NEXT_PUBLIC_TYPESENSE_SEARCH_KEY
#                    the search cluster and its search-only key, compiled into the bundle by next;
#                    a NEXT_PUBLIC_ name not declared below is dropped in silence
#   VITE_SENTRY_RELEASE
#                    the Sentry release compiled into the bundle; when set, the build's source
#                    maps get debug IDs (the sourcemaps target exports them for upload) and the
#                    static and oauth variants ship without maps
#   BUILD_VERSION    build number reported by releaseinfo/v1.0
#   COMMIT_SHA       built commit reported by releaseinfo/v1.0

ARG VARIANT=static

FROM quay.io/oauth2-proxy/oauth2-proxy:v7.15.6 AS oauth2proxy

########################
### build
########################
FROM node:26.13.1-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true
ENV NODE_OPTIONS=--max-old-space-size=4096
WORKDIR /repo
COPY . .
ARG PACKAGE
ARG BUILD_SCRIPT=build

# A package with its own lockfile is built where it sits; anything else is a member of the
# workspace at the context root. Which tool installs it follows from the lockfile, so no
# caller has to state something the repository already says.
COPY <<'INSTALL' /usr/local/bin/install-deps
#!/bin/sh
set -eu

# pnpm refuses a credential a project .npmrc expands from the environment.
export GH_PAT="$(cat /run/secrets/github_token)"
export NPM_CONFIG_USERCONFIG=/npmauth/npmrc
{
  printf '@n3oltd:registry=https://npm.pkg.github.com\n'
  printf '//npm.pkg.github.com/:_authToken=%s\n' "$GH_PAT"
} > "$NPM_CONFIG_USERCONFIG"

install_pnpm() {
  spec=$(node -p 'const pm = (f) => { try { return require(f).packageManager } catch {} }; pm(process.cwd() + "/package.json") || pm("/repo/package.json") || ""')
  case "$spec" in
    pnpm@*) npm install --global --allow-scripts=pnpm "${spec%%+*}" ;;
    *) echo "install-deps: no packageManager field names the pnpm to install ${PACKAGE} with" >&2; exit 1 ;;
  esac
}

if [ -f "${PACKAGE}/package-lock.json" ]; then
  cd "${PACKAGE}" && exec npm ci
fi
if [ -f "${PACKAGE}/pnpm-lock.yaml" ]; then
  cd "${PACKAGE}"
  install_pnpm
  exec pnpm install --frozen-lockfile
fi
install_pnpm
exec pnpm install --frozen-lockfile --fail-if-no-match --filter "${PACKAGE}..."
INSTALL
RUN chmod +x /usr/local/bin/install-deps

COPY <<'RUNBUILD' /usr/local/bin/run-build
#!/bin/sh
set -eu
if [ -f "${PACKAGE}/package-lock.json" ]; then cd "${PACKAGE}" && exec npm run "${BUILD_SCRIPT}"; fi
if [ -f "${PACKAGE}/pnpm-lock.yaml" ]; then cd "${PACKAGE}" && exec pnpm run "${BUILD_SCRIPT}"; fi
exec pnpm --fail-if-no-match --filter "${PACKAGE}" run "${BUILD_SCRIPT}"
RUNBUILD
RUN chmod +x /usr/local/bin/run-build

ENV PACKAGE=${PACKAGE} BUILD_SCRIPT=${BUILD_SCRIPT}
RUN --mount=type=secret,id=github_token,required=true --mount=type=tmpfs,target=/npmauth install-deps

# No ENV line: an ARG alone leaves a name nobody passed absent from the environment, where an
# ENV would materialise it as empty and defeat the app's own default. A NEXT_PUBLIC_ name is one
# the browser bundle may carry, so nothing private belongs in this block.
ARG NEXT_PUBLIC_TYPESENSE_URL
ARG NEXT_PUBLIC_TYPESENSE_SEARCH_KEY
ARG VITE_SENTRY_RELEASE
RUN run-build
ARG OUTPUT_DIR
# Injected here, before any stage copies the output, so the scripts that ship and the maps that
# are uploaded carry the same IDs. Matches the pin in .github/actions/n3o-sentry-inject.
RUN if [ -n "${VITE_SENTRY_RELEASE:-}" ] && [ -n "$(find "${OUTPUT_DIR}" -type f -name '*.map')" ]; then \
      npx --yes @sentry/cli@3.8.0 sourcemaps inject "${OUTPUT_DIR}"; \
    fi
ARG BUILD_VERSION
ARG COMMIT_SHA
RUN mkdir -p "${OUTPUT_DIR}/releaseinfo" && \
    node -e "process.stdout.write(JSON.stringify({releaseVersion:null,buildVersion:process.env.BUILD_VERSION||null,commit:process.env.COMMIT_SHA||null}))" \
    > "${OUTPUT_DIR}/releaseinfo/v1.0"

# Next copies nothing but its own output into standalone, and a missing public/ raises no error.
ARG APP_DIR
RUN app="${APP_DIR:-${OUTPUT_DIR%/.next}}"; \
    if [ -d "${OUTPUT_DIR}/standalone/${app}" ] && [ -d "${app}/public" ]; then \
      cp -R "${app}/public" "${OUTPUT_DIR}/standalone/${app}/"; \
    fi

########################
### sourcemaps
### requires the build to emit them
########################
FROM scratch AS sourcemaps
ARG OUTPUT_DIR
COPY --from=build /repo/${OUTPUT_DIR}/ /

# What the static and oauth variants serve. Files are removed here, not after a variant's COPY:
# a file deleted after the COPY still sits in the copied layer.
FROM build AS shipped
ARG OUTPUT_DIR
ARG VITE_SENTRY_RELEASE
RUN rm -rf "${OUTPUT_DIR}/.vite" && \
    if [ -n "${VITE_SENTRY_RELEASE:-}" ]; then find "${OUTPUT_DIR}" -type f -name '*.map' -delete; fi

########################
### variants
########################
FROM caddy:2.11.9-alpine AS variant-static
RUN apk add --no-cache jq
ARG OUTPUT_DIR
ARG BASE_PATH=/
ARG ENV_PREFIX=VITE_
ARG PORT=8080
ENV APP_BASE_PATH=${BASE_PATH}
ENV APP_ENV_PREFIX=${ENV_PREFIX}
ARG BUILD_VERSION
ARG COMMIT_SHA
ENV BUILD_VERSION=${BUILD_VERSION} COMMIT_SHA=${COMMIT_SHA}
# The build manifest is a version-pinned dependency inventory, never content to serve; shipped
# drops it.
COPY --from=shipped /repo/${OUTPUT_DIR} /srv${BASE_PATH}
# Config arrives here rather than at the compiler, so the artifact tested in one environment
# is the one promoted to the next, and a restart re-reads it. APP_BASE_HREF substitutes
# __APP_BASE__, so one image serves under different public paths.
RUN mv /srv${BASE_PATH}index.html /srv${BASE_PATH}index.html.tmpl && \
    if [ -f "/srv${BASE_PATH}content-security-policy.json" ]; then \
      mv "/srv${BASE_PATH}content-security-policy.json" /etc/caddy/content-security-policy.json; \
    fi
COPY <<'ENTRY' /usr/local/bin/inject-app-env
#!/bin/sh
set -eu
dir="/srv${APP_BASE_PATH}"
base_href="${APP_BASE_HREF:-${APP_BASE_PATH}}"
cfg=$(jq -n 'env | with_entries(select(.key | startswith(env.APP_ENV_PREFIX)))')
jq -Rs --argjson cfg "$cfg" --arg baseHref "$base_href" -r \
  'sub("<script id=\"__app_env_script__\"></script>";
       "<script id=\"__app_env_script__\">window.__APP_ENV__=" + ($cfg | tojson) + "</script>")
   | gsub("__APP_BASE__"; $baseHref)' \
  < "${dir}index.html.tmpl" > "${dir}index.html"
mkdir -p "${dir}releaseinfo"
jq -nc '{releaseVersion: env.RELEASE_VERSION, buildVersion: env.BUILD_VERSION, commit: env.COMMIT_SHA}' > "${dir}releaseinfo/v1.0"
policy_file=/etc/caddy/content-security-policy.json
if [ -f "$policy_file" ]; then
  if [ ! -s "$policy_file" ]; then
    echo "inject-app-env: content-security-policy.json is empty" >&2
    exit 1
  fi
  env_script=$(jq -Rrs 'capture("<script id=\"__app_env_script__\">(?<s>.*?)</script>"; "m").s // ""' < "${dir}index.html")
  hash=""
  if [ -n "$env_script" ]; then
    hash=$(printf '%s' "$env_script" | sha256sum | cut -d' ' -f1 | xxd -r -p | base64)
  fi
  report=$(jq -rn '
    (env.APP_ENV_PREFIX + "SENTRY_DSN") as $name
    | (env[$name] // "") as $dsn
    | if $dsn == "" then ""
      elif ($dsn | test("[`\"\r\n]")) then error("\($name) holds a backtick, a quote or a line break")
      else
        ($dsn | capture("^(?<scheme>https?)://(?<key>\\w+)(:[^@]*)?@(?<host>[\\w.-]+(:\\d+)?)/(?<prefix>([\\w.-]+/)*)(?<project>\\d+)$")
               // error("\($name) is not a Sentry DSN"))
        | "\(.scheme)://\(.host)/\(.prefix)api/\(.project)/security/?sentry_key=\(.key)"
          + ((env[env.APP_ENV_PREFIX + "ENVIRONMENT"] // "") as $environment
             | if $environment == "" then "" else "&sentry_environment=" + ($environment | @uri) end)
      end')
  jq -rs --arg hash "$hash" --arg report "$report" '
    def named($name): (.[0] | ascii_downcase) == $name;
    def with_source($name; $source):
      if any(.[]; named($name))
      then map(if named($name) and (any(.[1:][]; . == $source) | not) then . + [$source] else . end)
      else error("content-security-policy.json sets \($name), which its policy does not name") end;
    if length != 1 or (.[0] | type) != "object" then error("content-security-policy.json is not one JSON object") else .[0] end
    | if (.header | IN("Content-Security-Policy", "Content-Security-Policy-Report-Only")) | not then
      error("content-security-policy.json names \(.header | tojson), not a policy header")
    elif (.policy // "" | test("^\\s*$")) then
      error("content-security-policy.json holds no policy")
    else . end
    | [(.settings // {}) | to_entries[]
       | if .key | test("^[a-z-]+$") | not then error("content-security-policy.json names \(.key | tojson), not a directive") else . end
       | .key as $name | .value[] | . as $setting
       | if ($setting | startswith(env.APP_ENV_PREFIX)) | not then
           error("content-security-policy.json names \($setting | tojson) for \($name), not a setting the page receives")
         else (env[$setting] // "") end
       | if . == "" then error("content-security-policy.json names \($setting) for \($name), which is empty")
         elif test("[\\s;,\"'"'"'`]") then error("\($setting) holds \(tojson), which is not one source")
         else {name: $name, source: .} end] as $settings
    | (.policy
       | split(";") | map([splits("\\s+")] | map(select(. != ""))) | map(select(length > 0))
       | if any(.[]; named("script-src")) | not then
           error("content-security-policy.json has no script-src for the scripts its page runs")
         else . end
       | map(if $hash != "" and named("script-src") then . + ["'"'"'sha256-" + $hash + "'"'"'"] else . end)
       | reduce $settings[] as $setting (.; with_source($setting.name; $setting.source))
       | . + (if $report == "" then [] else [["report-uri", $report], ["report-to", "csp-endpoint"]] end)
       | map(join(" ")) | join("; ")) as $policy
    | if $policy | test("[`\r\n{},]") then
        error("the policy content-security-policy.json makes holds a backtick, a line break, a brace or a comma")
      else . end
    | "header \(.header) `\($policy)`"
      + (if $report == "" then "" else "\nheader Reporting-Endpoints `csp-endpoint=\"\($report)\"`" end)
  ' < "$policy_file" > /etc/caddy/content-security-policy.caddy
  export CADDY_CONTENT_SECURITY_POLICY="import /etc/caddy/content-security-policy.caddy"
fi
exec "$@"
ENTRY
RUN chmod +x /usr/local/bin/inject-app-env
ENTRYPOINT ["/usr/local/bin/inject-app-env"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
COPY <<CADDY /etc/caddy/Caddyfile
{
	auto_https off
}
:${PORT} {
	encode zstd gzip
	root * /srv
	{\$CADDY_CONTENT_SECURITY_POLICY}

	# A miss here is a miss: falling back serves HTML where a script was asked
	# for, and the browser executes it.
	handle ${BASE_PATH}assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle ${BASE_PATH}releaseinfo/v1.0 {
		header Content-Type application/json
		header Cache-Control "no-store"
		file_server
	}

	handle {
		header Cache-Control "no-store"
		try_files {path} ${BASE_PATH}index.html
		file_server
	}
}
CADDY
EXPOSE ${PORT}

FROM build AS prune
ARG PACKAGE
RUN cd "${PACKAGE}" && npm prune --omit=dev

FROM node:26.13.1-slim AS variant-node
ARG PORT=8080
ENV NODE_ENV=production PORT=${PORT}
ARG BUILD_VERSION
ARG COMMIT_SHA
ENV BUILD_VERSION=${BUILD_VERSION} COMMIT_SHA=${COMMIT_SHA}
WORKDIR /app
ARG PACKAGE
ARG START_ENTRY
COPY --from=prune --chown=node:node /repo/${PACKAGE} ./
ENV START_ENTRY=${START_ENTRY}
EXPOSE ${PORT}
USER node
CMD ["sh", "-c", "exec node ${START_ENTRY}"]

# Standalone output carries its own pruned node_modules, so the variant copies it
# alone; static assets sit beside the server at the path the build wrote them to.
FROM node:26.13.1-slim AS variant-next
ARG PORT=8080
ENV NODE_ENV=production PORT=${PORT} HOSTNAME=0.0.0.0
ARG BUILD_VERSION
ARG COMMIT_SHA
ENV BUILD_VERSION=${BUILD_VERSION} COMMIT_SHA=${COMMIT_SHA}
WORKDIR /app
ARG OUTPUT_DIR
ARG APP_DIR
COPY --from=build --chown=node:node /repo/${OUTPUT_DIR}/standalone ./
COPY --from=build --chown=node:node /repo/${OUTPUT_DIR}/static ./${OUTPUT_DIR}/static
ENV OUTPUT_DIR=${OUTPUT_DIR} APP_DIR=${APP_DIR}
EXPOSE ${PORT}
USER node
CMD ["sh", "-c", "exec node ${APP_DIR:-${OUTPUT_DIR%/.next}}/server.js"]

FROM oauth2proxy AS variant-oauth
ARG PORT=8080
ENV OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:${PORT}
ENV OAUTH2_PROXY_UPSTREAMS=file:///var/www/#/
ARG OUTPUT_DIR
COPY --from=shipped /repo/${OUTPUT_DIR} /var/www
EXPOSE ${PORT}

########################
### final
########################
FROM variant-${VARIANT} AS final
